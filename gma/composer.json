{
    "name": "graftcode/graftcode-php-module-analyzer",
    "description": "",
    "type": "library",
    "version": "1.0.1",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "graftcode/graftcode-php-storage": "2.0.4",
        "graftcode/graftcode-php-logger": "3.0.5",
        "graftcode/graftcode-php-protocol": "1.9.4",
        "nikic/php-parser": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": ">=12.0"
    },
    "autoload": {
        "psr-4": {
            "GraftcodeModuleAnalyzer\\": "GraftcodeModuleAnalyzer/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "vendor/graftcode/graftcode-php-storage",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "vendor/graftcode/graftcode-php-logger",
            "options": {
              "symlink": false
            }
        },
        {
            "type": "path",
            "url": "vendor/graftcode/graftcode-php-protocol",
            "options": {
              "symlink": false
            }
        }
    ],
    "authors": [
        {
          "name": "Graft Code Team",
          "email": "info@graftcode.com"
        }
    ],
    "keywords": [
        "graftcode",
        "graftcode-php-module-analyzer",
        "php"
    ],
    "scripts": {
      "install-local": [
        "git fetch --all --prune",
        "git add .",
        "git stash",
        "git merge origin/develop",
        "rm -rf vendor composer.lock .phpunit.result.cache",
        "composer clear-cache",
        "sh scripts/graftcode-package.sh",
        "composer install --no-cache"
      ],
      "tests": [
        "vendor/bin/phpunit"
      ]
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}

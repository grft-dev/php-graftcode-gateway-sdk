{
  "name": "graftcode/graftcode-php-logger",
  "description": "",
  "type": "library",
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": ">=12.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "GraftCodeLogger\\": "GraftCodeLogger/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "Tests/"
    }
  },
  "scripts": {
    "install-local": [
      "git fetch --all --prune ",
      "git add .",
      "git stash",
      "git merge origin/develop",
      "rm -rf vendor composer.lock .phpunit.result.cache",
      "composer clear-cache",
      "composer install --no-cache"
    ],
    "tests": [
      "vendor/bin/phpunit"
    ]
  },
  "authors": [
    {
      "name": "graftcode"
    }
  ],
  "keywords": [
    "graftcode",
    "graftcode-php-logger",
    "php"
  ],
  "prefer-stable": true,
  "minimum-stability": "stable",
  "version": "3.0.5"
}
